# Copy to .env and fill in.
# Generate with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_ENCRYPTION_KEY=

# Optional: paste an endpoint's signing secret here so the test receiver checks signatures.
RECEIVER_SECRET=

# Production settings worth setting (see docs/operations.md for all of them):
# COOKIE_SECURE=true
# TRUSTED_PROXY_COUNT=1        # number of proxies in front of the API
# METRICS_TOKEN=               # protects GET /metrics
